<?xml version="1.0" encoding="utf-8"?>
<!--
  SentinalDriver.vcxproj
  Sentinal AI minifilter driver - WDK MSBuild project

  Phase 1.24 - Windows Minifilter Foundation

  Requirements:
    - Windows Driver Kit (WDK) 10.0.28000.0
    - Visual Studio 2026 Community (MSBuild 18)
    - WDK Visual Studio extension installed

  Build:
    & "C:\Program Files\Microsoft Visual Studio\18\Community\MSBuild\Current\Bin\MSBuild.exe" `
        driver\SentinalDriver.vcxproj /p:Configuration=Debug /p:Platform=x64

  DriverType notes:
    A filesystem minifilter is a WDM driver using FltMgr APIs.
    There is no "MiniFilter" DriverType in WDK 10.0.28000.0.
    DriverType=WDM is the correct value; it imports:
      WindowsDriver.KernelMode.Wdm.props  (ntoskrnl.lib, hal.lib, wmilib.lib,
                                           BufferOverflowFastFailK.lib,
                                           GsDriverEntry entry point)
    fltMgr.lib is added below for FltRegisterFilter/FltStartFiltering/FltUnregisterFilter.
-->
<Project DefaultTargets="Build" ToolsVersion="12.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>

  <PropertyGroup Label="Globals">
    <ProjectGuid>{A1B2C3D4-E5F6-7890-ABCD-EF1234567890}</ProjectGuid>
    <TemplateGuid>{A1B2C3D4-E5F6-7890-ABCD-EF1234567890}</TemplateGuid>
    <ProjectName>SentinalDriver</ProjectName>
    <TargetFrameworkVersion>v4.5</TargetFrameworkVersion>
    <MinimumVisualStudioVersion>17.0</MinimumVisualStudioVersion>
    <Platform Condition="'$(Platform)'==''">x64</Platform>
    <!-- Windows Driver = modern desktop driver target (non-Universal) -->
    <DriverTargetPlatform>Windows Driver</DriverTargetPlatform>
    <!--
      InfVerif.dll is absent from this WDK 10.0.28000.0 installation.
      SkipPackageVerification suppresses the DPVerifierTask that loads it.
      INF correctness is verified separately via InfVerif.exe command-line.
    -->
    <SkipPackageVerification>true</SkipPackageVerification>
    <!--
      No code-signing certificate is configured for this dev build.
      Signing is deferred to a production/distribution phase.
      Per requirements, test signing and package cataloging are disabled.
    -->
    <SignMode>Off</SignMode>
    <EnableTestSign>false</EnableTestSign>
    <EnableInf2cat>false</EnableInf2cat>
    <DisableEmbeddedSigning>true</DisableEmbeddedSigning>
  </PropertyGroup>

  <!--
    Standard VC++ import chain.
    PlatformToolset=WindowsKernelModeDriver10.0 causes VS to load the WDK
    kernel-mode toolset from:
      $(VCTargetsPath)\Platforms\x64\PlatformToolsets\WindowsKernelModeDriver10.0\Toolset.props
    That toolset imports:
      WDKContentRoot\build\10.0.28000.0\WindowsDriver.Default.props
      WDKContentRoot\build\10.0.28000.0\x64\WindowsKernelModeDriver\WDK.x64.WindowsKernelModeDriver.props
      v145 (or v143) Toolset.props
      WDKContentRoot\DesignTime\...\WDK.props
  -->
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'" Label="Configuration">
    <TargetVersion>Windows10</TargetVersion>
    <UseDebugLibraries>true</UseDebugLibraries>
    <PlatformToolset>WindowsKernelModeDriver10.0</PlatformToolset>
    <ConfigurationType>Driver</ConfigurationType>
    <!-- WDM: imports WindowsDriver.KernelMode.Wdm.props which adds ntoskrnl/hal/wmilib
         and sets EntryPointSymbol=GsDriverEntry. Minifilter = WDM + FltMgr APIs. -->
    <DriverType>WDM</DriverType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'" Label="Configuration">
    <TargetVersion>Windows10</TargetVersion>
    <UseDebugLibraries>false</UseDebugLibraries>
    <PlatformToolset>WindowsKernelModeDriver10.0</PlatformToolset>
    <ConfigurationType>Driver</ConfigurationType>
    <DriverType>WDM</DriverType>
  </PropertyGroup>

  <!--
    Microsoft.Cpp.props loads Platform.props -> Toolset.props.
    This is where the full WDK props chain runs (WindowsDriver.KernelMode.props,
    WindowsDriver.KernelMode.Driver.props, WindowsDriver.KernelMode.Wdm.props).
  -->
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />

  <ImportGroup Label="ExtensionSettings" />

  <ImportGroup Label="PropertySheets">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props"
            Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')"
            Label="LocalAppDataPlatform" />
  </ImportGroup>

  <PropertyGroup Label="UserMacros" />

  <!-- Kernel debugger flavor for IDE integration -->
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <DebuggerFlavor>DbgengKernelDebugger</DebuggerFlavor>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <DebuggerFlavor>DbgengKernelDebugger</DebuggerFlavor>
  </PropertyGroup>

  <!--
    Project-specific build settings.
    Do NOT override AdditionalDependencies for Link here —
    WindowsDriver.KernelMode.Wdm.props has already set ntoskrnl.lib, hal.lib,
    wmilib.lib, BufferOverflowFastFailK.lib via %(AdditionalDependencies) chaining.
    We add fltMgr.lib separately below to avoid breaking that chain.
  -->
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(ProjectDir)include;$(ProjectDir)..\shared\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <DisableSpecificWarnings>4083;4005;%(DisableSpecificWarnings)</DisableSpecificWarnings>
    </ClCompile>
    <ClCompile Condition="'$(UseDebugLibraries)'=='true'">
      <PreprocessorDefinitions>DBG=1;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>

  <!--
    Add fltMgr.lib after the WDK has already accumulated ntoskrnl/hal/wmilib
    into %(AdditionalDependencies) via WindowsDriver.KernelMode.Wdm.props.
    Placing this in a separate ItemDefinitionGroup that references %(AdditionalDependencies)
    appends fltMgr.lib to the accumulated list.
  -->
  <ItemDefinitionGroup>
    <Link>
      <AdditionalDependencies>%(AdditionalDependencies);fltMgr.lib</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>

  <!-- Source files -->
  <ItemGroup>
    <ClCompile Include="src\driver_entry.c" />
    <ClCompile Include="src\observation_event.c" />
    <ClCompile Include="src\path_acquisition.c" />
    <ClCompile Include="src\communication_port.c" />
    <ClCompile Include="src\driver_contract_adapter.c" />
    <ClCompile Include="src\driver_unicode_contract_adapter.c" />
    <ClCompile Include="..\shared\src\driver_contract.c" />
    <ClCompile Include="..\shared\src\driver_unicode_contract.c" />
  </ItemGroup>

  <!-- Header files (informational; not compiled) -->
  <ItemGroup>
    <ClInclude Include="include\sentinal_driver.h" />
    <ClInclude Include="include\sentinal_observation_event.h" />
    <ClInclude Include="include\sentinal_path_acquisition.h" />
    <ClInclude Include="include\sentinal_communication_port.h" />
    <ClInclude Include="include\sentinal_driver_contract_adapter.h" />
    <ClInclude Include="include\sentinal_driver_unicode_contract_adapter.h" />
  </ItemGroup>

  <!--
    INF file. StampInf runs because @(Inf) is non-empty.
    stampinf.exe stamps the DriverVer line. The -v "*" flag uses the current
    date/time automatically (no explicit date needed when -v "*" is passed).
    InfVerif (DPVerifierTask) is skipped via SkipPackageVerification=true above.
  -->
  <ItemGroup>
    <Inf Include="SentinalDriver.inf" />
    <FilesToPackage Include="$(TargetPath)" />
  </ItemGroup>

  <!--
    Microsoft.Cpp.targets loads Platform.targets -> Toolset.targets.
    Toolset.targets imports WindowsDriver.Common.targets (Build, ClCompile,
    Link, StampInf, InfVerif, etc. targets are defined here).
  -->
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />

  <ImportGroup Label="ExtensionTargets" />

</Project>
